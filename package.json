{
  "name": "autoforge",
  "displayName": "AutoForge",
  "description": "AI code assistant with company knowledge",
  "version": "0.2.0",
  "publisher": "your-company",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "extensionDependencies": [
    "github.copilot-chat"
  ],
  "activationEvents": [],
  "contributes": {
    "configuration": {
      "title": "AutoForge",
      "properties": {
        "autoforge.framework.language": {
          "type": "string",
          "default": "java",
          "description": "The primary programming language of your project."
        },
        "autoforge.framework.types": {
          "type": "object",
          "default": {
            "controller": [
              "@RestController",
              "Controller"
            ],
            "service": [
              "@Service",
              "Service"
            ],
            "repository": [
              "@Repository",
              "Repository"
            ]
          },
          "description": "Keywords to identify different component types in your framework."
        },
        "autoforge.ingestion.include": {
          "type": "array",
          "default": [
            "**/*.java",
            "**/*.ts",
            "**/*.py"
          ],
          "description": "Glob patterns for files to include during workspace indexing."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autoforge",
          "title": "AutoForge",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "autoforge": [
        {
          "type": "webview",
          "id": "autoforge.chatViewV2",
          "name": "Chat",
          "icon": "media/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "autoforge.openChat",
        "title": "AutoForge: Open Chat"
      },
      {
        "command": "autoforge.showKBStats",
        "title": "AutoForge: Show Knowledge Base Stats"
      },
      {
        "command": "autoforge.listPatterns",
        "title": "AutoForge: List Saved Patterns"
      },
      {
        "command": "autoforge.ingestWorkspace",
        "title": "AutoForge: Index Workspace"
      },
      {
        "command": "autoforge.resetKnowledgeBase",
        "title": "AutoForge: Reset Knowledge Base"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.6",
    "@jest/globals": "^30.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/sql.js": "^1.4.9",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.25.11",
    "eslint": "^8.56.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@babel/core": "^7.28.5",
    "@babel/parser": "^7.28.5",
    "java-parser": "^3.0.1",
    "sql.js": "^1.10.3"
  }
}
